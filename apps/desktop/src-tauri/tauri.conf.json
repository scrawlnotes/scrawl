{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scrawl",
  "version": "0.1.0",
  "identifier": "app.scrawlnotes.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @scrawlnotes/web dev",
    "beforeBuildCommand": "pnpm --filter @scrawlnotes/web build"
  },
  "app": {
    "windows": [
      {
        "title": "Scrawl",
        "width": 1200,
        "height": 800,
        "minWidth": 480,
        "minHeight": 320
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
