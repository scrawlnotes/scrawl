{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scrawl",
  "version": "../package.json",
  "identifier": "app.scrawlnotes.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @scrawlnotes/web dev",
    "beforeBuildCommand": "pnpm --filter @scrawlnotes/web build"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "title": "Scrawl",
        "width": 1200,
        "height": 800,
        "maximized": true,
        "minWidth": 480,
        "minHeight": 320,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY1QkI5REU3NzgwQzNDNzcKUldSM1BBeDQ1NTI3OWNJQ3VwTm9NYjBOWFhqdk5jVU52d3IzS2RoM1JhNmpuYWdJbG5JK2srNnMK",
      "endpoints": ["https://github.com/scrawlnotes/scrawl/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
